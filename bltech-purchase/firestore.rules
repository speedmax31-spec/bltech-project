rules_version = '2';
// 구매관리 플랫폼 — docs/DATA-ID-RULES.md §6 구현. 정규식은 idcodes.js ID_RE 와 같아야 한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    function businessCol(col) {
      return col in ['materials', 'finishedstocks', 'purchaseorders', 'materialissues',
                     'itemcodes', 'purchaseforms', 'boms', 'productmap'];
    }
    // 업무 컬렉션별 문서 ID 모양 (코드 모양만 생성 허용 — 번호 ID·잘못된 모양은 거절)
    function codeOk(col, doc) {
      return (col == 'materials'      && doc.matches('^MAT-[A-Z]{2}-[0-9]{4,}$'))
          || (col == 'finishedstocks' && doc.matches('^FGS-(DOM|EXP|NA)-[0-9]{4,}$'))
          || (col == 'purchaseorders' && doc.matches('^PUR-[0-9]{8}-[0-9]{3,}$'))
          || (col == 'materialissues' && doc.matches('^ISS-[0-9]{8}-[0-9]{3,}$'))
          || (col == 'itemcodes'      && doc.matches('^ITM-[A-Z]{2}-[0-9]{4,}$'))
          || (col == 'purchaseforms'  && doc.matches('^POF-[0-9]{8}-[0-9]{2,}$'))
          || (col == 'boms'           && doc.matches('^BOM-[A-Z0-9]+-[0-9]{4,}$'))
          || (col == 'productmap'     && doc.matches('^PMP-[0-9]{5,}$'));
    }

    // 업무 문서: 코드 모양 ID + 문서 안 id 필드 = 문서 이름. 수정 시 id 변경 불가.
    match /{col}/{doc} {
      allow read: if authed() && businessCol(col);
      allow create: if authed() && codeOk(col, doc) && request.resource.data.id == doc;
      allow update: if authed() && businessCol(col) && request.resource.data.id == doc
                    && resource.data.id == doc;
      allow delete: if authed() && businessCol(col);
    }
    // 일련번호 카운터 meta/seq_{그룹}
    match /meta/{doc} {
      allow read, write: if authed() && doc.matches('^seq_[A-Z]{3}(-[A-Z0-9]+)*$');
    }
    // 앱 상태 (업무 규칙 예외 — 설정·뉴스·원가 모델 등, 문서 이름은 camelCase 키)
    // 목록 조회(list)는 문서 이름 변수를 검사하지 않는다 — 검사하면 실제 목록 조회가 거절된다
    match /appstate/{doc} {
      allow list: if authed();
      allow get, write: if authed() && doc.matches('^[a-z][A-Za-z0-9]*$');
    }
  }
}
